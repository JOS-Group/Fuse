# Fuse Semantic Platform Environment Configuration Template

# ---------------------------------------------------------------------------
# 1. SNOWFLAKE CONFIGURATION (Live Cloud Data Warehouse)
# ---------------------------------------------------------------------------
# Format: <ORG_NAME>-<ACCOUNT_NAME> or account locator
SNOWFLAKE_ACCOUNT="your-account-identifier"
SNOWFLAKE_USER="your-username"
SNOWFLAKE_PASSWORD="your-password"
SNOWFLAKE_DATABASE="FUSE_DB"
SNOWFLAKE_SCHEMA="MEDICAL"
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"
SNOWFLAKE_ROLE="ACCOUNTADMIN"

# ---------------------------------------------------------------------------
# 2. AWS S3 CONFIGURATION (Live Healthcare Data Lake)
# ---------------------------------------------------------------------------
AWS_REGION="us-east-2"
AWS_S3_BUCKET="your-s3-bucket-name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# 3. TRINO FEDERATION COORDINATOR (Optional)
# ---------------------------------------------------------------------------
TRINO_HOST=""
TRINO_PORT="8080"
TRINO_USER="fuse_admin"
TRINO_SCHEME="http"
